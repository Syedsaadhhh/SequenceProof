# SequenceProof environment variables
# Copy to .env and populate as needed.
# Never commit real secrets to version control.

# ── Sandbox providers ──────────────────────────────────────────────────────

# Daytona: primary hosted sandbox provider
# Required: obtain from https://app.daytona.io
# DAYTONA_API_KEY=

# Optional: override the Daytona API base URL (default: https://app.daytona.io/api)
# DAYTONA_API_URL=https://app.daytona.io/api

# Explicit provider selection (optional: auto-selects first available if unset)
# Valid values: daytona, docker
# FakeSandboxProvider is never a valid value here.
# SEQUENCEPROOF_PROVIDER=daytona

# ── Server ─────────────────────────────────────────────────────────────────

# Listen host (default: 127.0.0.1)
# HOST=127.0.0.1

# Listen port (default: 8000)
# PORT=8000

# Suppress per-request access log lines in tests (default: unset = show logs)
# SEQUENCEPROOF_QUIET_LOG=1
